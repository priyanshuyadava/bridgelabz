// Q9 – JSON Audit
// Parse JSON data using try-catch.
// Detect invalid JSON and missing keys.
// Store valid entries in a clean array.
// Convert age to Number and filter under-18 users.

console.log("\nQ9 - JSON AUDIT");

const rawData = [
    '{"user":"Alex","age":25}',
    '{"id":2}',
    '{invalid}',
    '{"user":"Mina","age":"22"}'
];

const cleanData = [];
const jsonErrors = [];

for (let i = 0; i < rawData.length; i++) {
    try {
        debugger;

        const parsedData = JSON.parse(rawData[i]);

        if (
            parsedData.user === undefined ||
            parsedData.age === undefined
        ) {
            throw new Error("Missing user or age key");
        }

        parsedData.age = Number(parsedData.age);

        if (!Number.isFinite(parsedData.age)) {
            throw new Error("Invalid age value");
        }

        cleanData.push(parsedData);

        console.log(`Line ${i + 1}: Valid JSON`);

    } catch (error) {
        jsonErrors.push({
            line: i + 1,
            error: error.message
        });

        console.log(`Line ${i + 1}: ${error.message}`);
    }
}

console.log("Clean Data:", cleanData);
console.log("JSON Errors:", jsonErrors);

const under18 = cleanData.filter(user => user.age < 18);

console.log("Users Under 18:", under18);


