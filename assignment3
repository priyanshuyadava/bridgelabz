// Q1 – Dynamic Data Parser
// Convert mixed API data into Number, Boolean and String.
// Skip invalid numbers and store valid and invalid values
// in separate arrays. Print a detailed report.

const apiData = [
    "25", "true", "false", "NaN", " ", "100px",
    "3.14", null, undefined
];

const validNumbers = [];
const invalidNumbers = [];

console.log("\nQ1 - DYNAMIC DATA PARSER");

for (let value of apiData) {
    const numberValue = Number(value);
    const booleanValue = Boolean(value);
    const stringValue = String(value);

    console.log("Original:", value);
    console.log("Number:", numberValue);
    console.log("Boolean:", booleanValue);
    console.log("String:", stringValue);

    if (
        value === null ||
        value === undefined ||
        String(value).trim() === "" ||
        Number.isNaN(numberValue)
    ) {
        invalidNumbers.push(value);
    } else {
        validNumbers.push(numberValue);
    }

    console.log("----------------------");
}

console.log("Valid Numbers:", validNumbers);
console.log("Invalid Numbers:", invalidNumbers);


// Q2 – Employee Bonus Calculator
// Convert salary and years into numbers.
// Calculate bonus: 10% if experience is greater than 3 years,
// otherwise 5%. Use strict mode, template strings and try-catch.

const employees = [
    { name: "Amit", salary: "45000", years: "5" },
    { name: "Sara", salary: "38000", years: "2" },
    { name: "Kiran", salary: "52000", years: "7" }
];

console.log("\nQ2 - EMPLOYEE BONUS CALCULATOR");

try {
    for (let employee of employees) {
        if (
            !employee.name ||
            employee.salary === undefined ||
            employee.years === undefined
        ) {
            throw new Error("Missing employee information");
        }

        const salary = Number(employee.salary);
        const years = Number(employee.years);

        if (!Number.isFinite(salary) || !Number.isFinite(years)) {
            throw new Error("Invalid salary or experience");
        }

        const bonus = years > 3
            ? salary * 0.10
            : salary * 0.05;

        console.log(`
Employee: ${employee.name}
Salary: ${salary}
Experience: ${years} years
Bonus: ${bonus}
Total Salary: ${salary + bonus}
----------------------
`);
    }
} catch (error) {
    console.log("Error:", error.message);
}


// Q3 – Transaction Validator
// Check every transaction.
// Throw custom errors for negative amount, missing id or amount,
// and null entries. Store valid and invalid transactions separately.
// Use debugger to watch variable states.

const transactions = [
    { id: 1, amount: 2000 },
    { id: 2, amount: -500 },
    { id: 3 },
    null
];

const validTransactions = [];
const invalidTransactions = [];

console.log("\nQ3 - TRANSACTION VALIDATOR");

for (let transaction of transactions) {
    try {
        debugger;

        if (transaction === null) {
            throw new Error("NULL_ENTRY");
        }

        if (
            transaction.id === undefined ||
            transaction.amount === undefined
        ) {
            throw new Error("MISSING_DATA");
        }

        if (transaction.amount < 0) {
            throw new Error("NEGATIVE_AMOUNT");
        }

        validTransactions.push(transaction);
        console.log("Valid Transaction:", transaction);

    } catch (error) {
        invalidTransactions.push({
            transaction: transaction,
            reason: error.message
        });

        console.log("Invalid Transaction:", error.message);
    }
}

console.log("Valid Transactions:", validTransactions);
console.log("Invalid Transactions:", invalidTransactions);
console.log("Successful Count:", validTransactions.length);
console.log("Failed Count:", invalidTransactions.length);


