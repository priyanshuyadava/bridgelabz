// Q6 – Pyramid Pattern Generator
// Generate a star pyramid using nested loops.
// Use var and let to observe variable reuse.
// Get the number of rows from user input if available.
// Default value is 5. Use strict mode to catch undeclared variables.

console.log("\nQ6 - PYRAMID PATTERN");

let rows = 5;

// Node.js command-line input can be passed as an argument.
// Example: node Assignment3.js 4
if (typeof process !== "undefined" && process.argv[2] !== undefined) {
    const inputRows = Number(process.argv[2]);

    if (Number.isInteger(inputRows) && inputRows > 0) {
        rows = inputRows;
    } else {
        console.log("Invalid input. Using default 5 rows.");
    }
}

for (let i = 1; i <= rows; i++) {
    let pattern = "";

    for (let j = 1; j <= i; j++) {
        pattern += "* ";
    }

    console.log(pattern);
}

// Using var instead of let
console.log("Pyramid using var:");

for (var i = 1; i <= 4; i++) {
    var pattern = "";

    for (var j = 1; j <= i; j++) {
        pattern += "* ";
    }

    console.log(pattern);
}

// var is function-scoped, while let is block-scoped.
// Both produce the same pyramid in these loops.


// Q7 – Smart Calculator
// Use switch to perform addition, division, power,
// square root and subtraction.
// Handle division by zero and negative square root.
// Throw an error for invalid operations.

console.log("\nQ7 - SMART CALCULATOR");

const operations = ["add", "divide", "power", "root", "subtract"];

const num1 = 25;
const num2 = 0;

class InvalidOperationError extends Error {
    constructor(message) {
        super(message);
        this.name = "InvalidOperationError";
    }
}

function calculate(operation, a, b) {
    switch (operation) {
        case "add":
            return a + b;

        case "divide":
            if (b === 0) {
                throw new Error("Cannot divide by zero");
            }
            return a / b;

        case "power":
            return Math.pow(a, b);

        case "root":
            if (a < 0) {
                throw new Error("Cannot find square root of negative number");
            }
            return Math.sqrt(a);

        case "subtract":
            return a - b;

        default:
            throw new InvalidOperationError("Invalid operation");
    }
}

for (let operation of operations) {
    try {
        const result = calculate(operation, num1, num2);

        console.log(`${operation}: ${result}`);

    } catch (error) {
        console.log(`${operation} Error: ${error.message}`);
    }
}


