// Q7 – The Lazy Loader: Promise Combinator Practice
// Task: Use Promise.allSettled() for multiple async calls
// and calculate total time taken.

function loadProfile() {
    return new Promise((resolve, reject) => {
        setTimeout(() => {
            Math.random() < 0.3
                ? reject("Profile loading failed")
                : resolve("Profile Loaded");
        }, 2000);
    });
}

function loadPosts() {
    return new Promise((resolve, reject) => {
        setTimeout(() => {
            Math.random() < 0.3
                ? reject("Posts loading failed")
                : resolve("Posts Loaded");
        }, 1500);
    });
}

function loadMessages() {
    return new Promise((resolve, reject) => {
        setTimeout(() => {
            Math.random() < 0.3
                ? reject("Messages loading failed")
                : resolve("Messages Loaded");
        }, 1000);
    });
}

async function loadDashboard() {
    const startTime = Date.now();

    const results = await Promise.allSettled([
        loadProfile(),
        loadPosts(),
        loadMessages()
    ]);

    const modules = ["Profile", "Posts", "Messages"];

    results.forEach((result, index) => {
        if (result.status === "fulfilled") {
            console.log(modules[index] + " Success:", result.value);
        } else {
            console.log(modules[index] + " Failed:", result.reason);
        }
    });

    const endTime = Date.now();

    console.log("Total time taken:", endTime - startTime, "ms");
}

loadDashboard();


