// PART 1: Nested Callbacks

function design(callback) {
    setTimeout(() => {
        console.log("Design completed");
        callback();
    }, 1000);
}

function build(callback) {
    setTimeout(() => {
        console.log("Build completed");
        callback();
    }, 1000);
}

function test(callback) {
    setTimeout(() => {
        console.log("Test completed");
        callback();
    }, 1000);
}

function deploy(callback) {
    setTimeout(() => {
        console.log("Deploy completed");
        callback();
    }, 1000);
}

function celebrate(callback) {
    setTimeout(() => {
        console.log("Celebrate completed");
        callback();
    }, 1000);
}

console.log("Starting Callback Pipeline");

design(() => {
    build(() => {
        test(() => {
            deploy(() => {
                celebrate(() => {
                    console.log("Callback Pipeline Completed");
                });
            });
        });
    });
});

// PART 2: Async/Await

function asyncStage(stageName) {
    return new Promise(resolve => {
        setTimeout(() => {
            console.log(stageName + " completed");
            resolve();
        }, 1000);
    });
}

async function runAsyncPipeline() {
    console.log("Starting Async/Await Pipeline");

    await asyncStage("Design");
    await asyncStage("Build");
    await asyncStage("Test");
    await asyncStage("Deploy");
    await asyncStage("Celebrate");

    console.log("Async/Await Pipeline Completed");
}

runAsyncPipeline();

// Explanation:
// Async/await makes asynchronous code easier to read.
// It avoids deeply nested callbacks and looks like
// normal sequential code.


