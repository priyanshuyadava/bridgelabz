// Q10 – The Final Delivery: Async Pipeline Debugger
// Task: Create an asynchronous food delivery pipeline.
// Each step has a random 1–2 second delay and failure chance.

function deliveryStep(stepName, successMessage) {
    return new Promise((resolve, reject) => {

        // Generate random delay between 1 and 2 seconds
        const delay = Math.floor(Math.random() * 1000) + 1000;

        setTimeout(() => {

            // Randomly fail a step
            if (Math.random() < 0.2) {
                reject(stepName + " failed");
            } else {
                console.log(successMessage);
                resolve();
            }

        }, delay);
    });
}

// Individual delivery steps
function takeOrder() {
    return deliveryStep("Take Order", "Step 1: Order taken");
}

function prepare() {
    return deliveryStep("Prepare", "Step 2: Food prepared");
}

function pack() {
    return deliveryStep("Pack", "Step 3: Package ready");
}

function dispatch() {
    return deliveryStep("Dispatch", "Step 4: Out for delivery");
}

function deliver() {
    return deliveryStep("Deliver", "Delivery completed!");
}

// Run the complete pipeline using async/await
async function runPipeline() {
    console.log("Start Pipeline");

    try {
        // Each await waits for the previous step
        await takeOrder();
        await prepare();
        await pack();
        await dispatch();
        await deliver();

    } catch (error) {
        // Stop pipeline if any step fails
        console.log("Pipeline failed!");
        console.log("Reason:", error);
    }
}

runPipeline();


