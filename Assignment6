// Q3 – Bug Tracker: Callback to Promise Migration
// Task: Convert callback function into Promise-based getBugs().

function getBugs() {
    return new Promise((resolve, reject) => {
        setTimeout(() => {
            const randomFailure = Math.random() < 0.3;

            if (randomFailure) {
                reject("API failed to fetch bugs!");
            } else {
                resolve([
                    "UI glitch",
                    "API timeout",
                    "Login failure"
                ]);
            }
        }, 1000);
    });
}

getBugs()
    .then(bugs => {
        console.log("Bug List:");
        console.table(bugs.map((bug, index) => ({
            "Bug Number": index + 1,
            "Bug Description": bug
        })));
    })
    .catch(error => console.log("Error:", error));


