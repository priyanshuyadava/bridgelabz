    }
}


// Q8. Employee Salary Projection
// Declare current salary and annual increment rate.
// Use a for loop to calculate salary for 5 years.
// Apply yearly increments and display using console.table().

let currentSalary = 30000;
const incrementRate = 10;

const salaryProjection = [];

for (let year = 1; year <= 5; year++) {
    currentSalary += currentSalary * incrementRate / 100;

    salaryProjection.push({
        Year: year,
        Salary: Math.round(currentSalary)
    });
}

console.table(salaryProjection);


// Q9. Random Math Quiz Generator
// Generate two random numbers between 1 and 20.
// Select a random operator from +, -, *, /.
// Use switch to calculate the correct answer.
// Round division answers to 2 decimal places.

const number1 = Math.floor(Math.random() * 20) + 1;
const number2 = Math.floor(Math.random() * 20) + 1;

const operators = ["+", "-", "*", "/"];

const randomOperator = operators[
    Math.floor(Math.random() * operators.length)
];

let correctAnswer;

switch (randomOperator) {
    case "+":
        correctAnswer = number1 + number2;
        break;

    case "-":
        correctAnswer = number1 - number2;
        break;

    case "*":
        correctAnswer = number1 * number2;
        break;

    case "/":
        correctAnswer = (number1 / number2).toFixed(2);
        break;

    default:
        console.log("Invalid Operator");
}

console.log("RANDOM MATH QUIZ");
console.log(`Question: ${number1} ${randomOperator} ${number2}`);
console.log("Correct Answer:", correctAnswer);


