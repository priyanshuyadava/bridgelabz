// Q1. Personalized Login Greeting
// Declare userName and current hour using Date().
// Before 12 = Good Morning.
// Between 12 and 17 = Good Afternoon.
// Otherwise = Good Evening.
// Use template literals.

const userName = "Rahul";
const currentHour = new Date().getHours();

if (currentHour < 12) {
    console.log(`Good Morning ${userName}!`);
} else if (currentHour >= 12 && currentHour <= 17) {
    console.log(`Good Afternoon ${userName}!`);
} else {
    console.log(`Good Evening ${userName}!`);
}


// Q2. Multi-Type Data Summary
// Declare variables of different data types.
// Use typeof and Array.isArray() to identify types.
// Display a formatted report using console.table().

const userString = "Rahul";
const userNumber = 25;
const userBoolean = true;
const userArray = [10, 20, 30];
const userObject = { name: "Rahul", age: 21 };
const userNull = null;
let userUndefined;

const dataSummary = [
    {
        Label: "String",
        Value: userString,
        Type: typeof userString
    },
    {
        Label: "Number",
        Value: userNumber,
        Type: typeof userNumber
    },
    {
        Label: "Boolean",
        Value: userBoolean,
        Type: typeof userBoolean
    },
    {
        Label: "Array",
        Value: JSON.stringify(userArray),
        Type: Array.isArray(userArray) ? "Array" : typeof userArray
    },
    {
        Label: "Object",
        Value: JSON.stringify(userObject),
        Type: typeof userObject
    },
    {
        Label: "Null",
        Value: userNull,
        Type: userNull === null ? "null" : typeof userNull
    },
    {
        Label: "Undefined",
        Value: userUndefined,
        Type: typeof userUndefined
    }
];

console.table(dataSummary);


// Q3. Monthly Expense Tracker
// Create an array of 5 monthly expenses.
// Calculate total and average expenses.
// Add 10% tax using arithmetic and assignment operators.
// Display values using toFixed(2).

const expenses = {
    food: 5000,
    travel: 2000,
    rent: 10000,
    bills: 1500,
    leisure: 1500
};

let totalExpense = 0;

for (let category in expenses) {
    totalExpense += expenses[category];
}

const averageExpense = totalExpense / 5;

const tax = totalExpense * 0.10;

let finalAmount = totalExpense;
finalAmount += tax;

console.log("MONTHLY EXPENSE REPORT");
console.log("Total Expense:", totalExpense.toFixed(2));
console.log("Average Expense:", averageExpense.toFixed(2));
console.log("Tax (10%):", tax.toFixed(2));
console.log("Final Amount:", finalAmount.toFixed(2));


// Q4. Academic Performance Evaluator
// Store marks of 5 subjects in an array.
// Calculate average and percentage.
// If any subject is below 35, student is detained.
// 85% or above = Distinction.
// 50% to 84% = Promoted.
// Below 50% = Detained.

const marks = [85, 90, 78, 88, 92];

let totalMarks = 0;

for (let mark of marks) {
    totalMarks += mark;
}

const averageMarks = totalMarks / marks.length;
const percentage = (totalMarks / (marks.length * 100)) * 100;

const hasFailed = marks.some(mark => mark < 35);

console.log("Total Marks:", totalMarks);
console.log("Average Marks:", averageMarks);
console.log("Percentage:", percentage.toFixed(2) + "%");

if (hasFailed || percentage < 50) {
    console.log("Detained");
} else if (percentage >= 85) {
    console.log("Promoted with Distinction");
} else {
    console.log("Promoted");
}


