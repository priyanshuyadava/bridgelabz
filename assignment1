// Q6. Progressive Discount System
// Input the total purchase amount.
// 10000 or above = 25% discount.
// 5000 or above = 15% discount.
// 2000 or above = 5% discount.
// Otherwise = no discount.
// Use Math.round() to round the final price.

const purchaseAmount = 12000;

let discountPercentage = 0;

if (purchaseAmount >= 10000) {
    discountPercentage = 25;
} else if (purchaseAmount >= 5000) {
    discountPercentage = 15;
} else if (purchaseAmount >= 2000) {
    discountPercentage = 5;
} else {
    discountPercentage = 0;
}

const discountAmount = purchaseAmount * discountPercentage / 100;

const finalPrice = Math.round(purchaseAmount - discountAmount);

console.log("PROGRESSIVE DISCOUNT REPORT");
console.log("Original Total:", purchaseAmount);
console.log("Discount Percentage:", discountPercentage + "%");
console.log("Discount Amount:", discountAmount);
console.log("Final Price:", finalPrice);


// Q7. Smart Guessing Game (Number Range)
// Generate a random secret number between 1 and 50.
// Set userGuess with a test value.
// Equal = Correct guess.
// Within 3 = Very close.
// Otherwise = Too high or Too low.

