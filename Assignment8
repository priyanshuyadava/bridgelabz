// ==================== Q6. E-Commerce Inventory System ====================

let products = [
    { id: 1, name: "Laptop", category: "Electronics", price: 50000, stock: 5 },
    { id: 2, name: "Mobile", category: "Electronics", price: 20000, stock: 3 },
    { id: 3, name: "Shirt", category: "Clothing", price: 1000, stock: 20 },
    { id: 4, name: "Jeans", category: "Clothing", price: 1500, stock: 4 },
    { id: 5, name: "Shoes", category: "Footwear", price: 2500, stock: 10 }
];

// 1. Get low stock products using filter()
function getLowStockProducts() {
    return products.filter(p => p.stock < 5);
}

// 2. Sort products by price using sort()
function sortProductsByPrice() {
    return [...products].sort((a, b) => a.price - b.price);
}

// 3. Calculate total inventory value using reduce()
function calculateTotalInventoryValue() {
    return products.reduce((sum, p) => sum + p.price * p.stock, 0);
}

// 4. Group products by category using reduce()
function groupByCategory() {
    return products.reduce((groups, p) => {
        if (!groups[p.category]) {
            groups[p.category] = [];
        }
        groups[p.category].push(p);
        return groups;
    }, {});
}

// Display results
console.log("Low Stock:", getLowStockProducts());
console.log("Sorted Products:", sortProductsByPrice());
console.log("Inventory Value:", calculateTotalInventoryValue());
console.log("Grouped Products:", groupByCategory());


// ==================== Q7. Banking Application ====================

class BankAccount {
    // Private balance field
    #balance;

    constructor(balance) {
        this.#balance = balance;
    }

    // Deposit money
    deposit(amount) {
        if (amount <= 0)
            throw new Error("Invalid deposit amount");

        this.#balance += amount;
    }

    // Withdraw money
    withdraw(amount) {
        if (amount <= 0)
            throw new Error("Invalid withdrawal amount");

        if (amount > this.#balance)
            throw new Error("Insufficient balance");

        this.#balance -= amount;
    }

    // Get current balance
    getBalance() {
        return this.#balance;
    }
}

let account = new BankAccount(5000);

// Valid deposit
account.deposit(2000);
console.log("Balance:", account.getBalance());

// Invalid withdrawal handled using try-catch
try {
    account.withdraw(10000);
} catch (error) {
    console.log("Error:", error.message);
}

console.log("Final Balance:", account.getBalance());


// ==================== Q8. Movie Ticket Booking System ====================

class MovieTicket {
    constructor(movieName, seatNo, price) {
        this.movieName = movieName;
        this.seatNo = seatNo;
        this.price = price;
    }
}

// Add printTicket() method to MovieTicket prototype
MovieTicket.prototype.printTicket = function() {
    console.log("Movie:", this.movieName);
    console.log("Seat:", this.seatNo);
    console.log("Price:", this.price);
};

// OnlineTicket inherits MovieTicket
class OnlineTicket extends MovieTicket {
    constructor(movieName, seatNo, price, convenienceFee) {
        super(movieName, seatNo, price);
        this.convenienceFee = convenienceFee;
    }

    // Calculate total amount
    getTotalAmount() {
        return this.price + this.convenienceFee;
    }
}

let t1 = new OnlineTicket("Avengers", "A12", 200, 30);
let t2 = new OnlineTicket("Avatar", "B10", 250, 40);

// Call parent prototype method using child objects
t1.printTicket();
console.log("Total Amount:", t1.getTotalAmount());

t2.printTicket();
console.log("Total Amount:", t2.getTotalAmount());


// ==================== Q9. Fitness App Analytics ====================

class FitnessAnalytics {
    constructor(data) {
        // Check if dataset is empty
        if (data.length === 0)
            throw new Error("Dataset is empty");

        this.data = data;
    }

    // Get active users using filter()
    getActiveUsers() {
        return this.data.filter(u => u.steps > 7000);
    }

    // Calculate average calories using reduce()
    getAverageCalories() {
        return this.data.reduce((sum, u) => sum + u.calories, 0) / this.data.length;
    }

    // Get user summary using map()
    getUserSummary() {
        return this.data.map(u =>
            `${u.user} burned ${u.calories} calories and walked ${u.steps} steps`
        );
    }
}

// Workout data
let data = [
    { user: "A", steps: 8000, calories: 300 },
    { user: "B", steps: 12000, calories: 500 },
    { user: "C", steps: 4000, calories: 200 }
];

// Execute all methods
try {
    let f = new FitnessAnalytics(data);

    console.log("Active Users:", f.getActiveUsers());
    console.log("Average Calories:", f.getAverageCalories());
    console.log("User Summary:", f.getUserSummary());

} catch (error) {
    console.log("Error:", error.message);
}
