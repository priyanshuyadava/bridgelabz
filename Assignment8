
// ==================== Q1. Student Result Processing (reduce + Classes) ====================

class Student {
    constructor(name, marks) {
        this.name = name;
        this.marks = marks;
    }

    // Calculate average using reduce()
    calculateAverage() {
        return this.marks.reduce((a, b) => a + b, 0) / this.marks.length;
    }

    // Return grade based on average
    getGrade() {
        let avg = this.calculateAverage();
        return avg >= 80 ? "A" : avg >= 60 ? "B" : avg >= 40 ? "C" : "F";
    }
}

let students = [
    new Student("Rahul", [85, 90, 80]),
    new Student("Aman", [65, 70, 60]),
    new Student("Priya", [30, 35, 40])
];

students.forEach(s => console.log(s.name, s.calculateAverage(), s.getGrade()));


// ==================== Q2. Online Food Ordering (map + Error Handling) ====================

const menu = [
    { name: "Pizza", price: 200 },
    { name: "Burger", price: 100 },
    { name: "Pasta", price: 150 }
];

function calculateBill(orderItems) {
    try {
        // Get prices using map()
        let prices = orderItems.map(item => {
            let food = menu.find(m => m.name === item);

            if (!food) throw new Error(item + " is unavailable");

            return food.price;
        });

        // Calculate total using reduce()
        let total = prices.reduce((a, b) => a + b, 0);
        console.log("Total Bill:", total);

    } catch (error) {
        console.log("Error:", error.message);
    }
}

calculateBill(["Pizza", "Burger"]);
calculateBill(["Pizza", "Sandwich"]);


