<script>
const gallery = document.getElementById("gallery");
const modal = document.getElementById("imageModal");
const modalImage = document.getElementById("modalImage");
const modalContent = document.querySelector(".modal-content");

// Open modal on image click
gallery.addEventListener("click", (event) => {
    if (event.target.tagName === "IMG") {
        modalImage.src = event.target.src;
        modalImage.alt = event.target.alt;
        modal.classList.remove("hidden");
    }
});

// Prevent closing when clicking inside modal
modalContent.addEventListener("click", (event) => {
    event.stopPropagation();
});

// Close when clicking outside
modal.addEventListener("click", () => {
    modal.classList.add("hidden");
});

// Close button
document.getElementById("closeModal").addEventListener("click", () => {
    modal.classList.add("hidden");
});
</script>


<!-- Q6. Real-Time Table Filter Using Input Event -->

<section>
<h2>Q6. Real-Time Table Filter</h2>

<input id="studentSearch" placeholder="Search students">

<table>
<thead>
<tr><th>Name</th><th>Branch</th><th>CGPA</th></tr>
</thead>

<tbody id="studentRows">
<tr><td>Priya</td><td>CSE</td><td>8.2</td></tr>
<tr><td>Rahul</td><td>ECE</td><td>7.5</td></tr>
<tr><td>Aman</td><td>IT</td><td>8.8</td></tr>
<tr><td>Neha</td><td>CSE</td><td>9.1</td></tr>
</tbody>
</table>

<p id="noResults" class="error hidden">No results found</p>
</section>

<script>
const searchInput = document.getElementById("studentSearch");
const rows = document.querySelectorAll("#studentRows tr");
const noResults = document.getElementById("noResults");

// Filter table while typing
searchInput.addEventListener("input", () => {
    const searchText = searchInput.value.toLowerCase().trim();
    let found = 0;

    rows.forEach(row => {
        const rowData = row.textContent.toLowerCase();

        if (rowData.includes(searchText)) {
            row.style.display = "";
            found++;
        } else {
            row.style.display = "none";
        }
    });

    // Show message if no results
    noResults.classList.toggle("hidden", found !== 0);
});
</script>


<!-- Q7. Detect Mouse Path and Coordinates Logger -->

<section>
<h2>Q7. Mouse Coordinates Logger</h2>

<div id="coordinateBox">
    <p id="coordinates">Move mouse here</p>
</div>
</section>

<script>
const box = document.getElementById("coordinateBox");
const coordinates = document.getElementById("coordinates");

// Track mouse movement
box.addEventListener("mousemove", (event) => {
    coordinates.textContent =
        "clientX: " + event.clientX +
        " | clientY: " + event.clientY;
});

// Drop red dot on double click
box.addEventListener("dblclick", (event) => {
    const rect = box.getBoundingClientRect();

    const dot = document.createElement("span");
    dot.className = "mouse-dot";

    dot.style.left = (event.clientX - rect.left) + "px";
    dot.style.top = (event.clientY - rect.top) + "px";

    box.appendChild(dot);
});
</script>


<!-- Q8. Custom Dropdown Using Only JavaScript (No Select Tag) -->

<section>
<h2>Q8. Custom Dropdown</h2>

<div id="customDropdown">
    <button id="dropdownButton">Choose Subject</button>

    <div id="dropdownOptions" class="dropdown-options hidden">
        <button type="button">JavaScript</button>
        <button type="button">Java</button>
        <button type="button">Python</button>
    </div>
</div>
</section>

<script>
const dropdown = document.getElementById("customDropdown");
const dropdownButton = document.getElementById("dropdownButton");
const options = document.getElementById("dropdownOptions");

// Show and hide options
dropdownButton.addEventListener("click", (event) => {
    event.stopPropagation();
    options.classList.toggle("hidden");
});

// Select option
options.addEventListener("click", (event) => {
    if (event.target.tagName === "BUTTON") {
        dropdownButton.textContent = event.target.textContent;
        options.classList.add("hidden");
    }
});

// Close dropdown using capturing phase
document.addEventListener("click", (event) => {
    if (!dropdown.contains(event.target)) {
        options.classList.add("hidden");
    }
}, true);
</script>


<!-- Q9. Form Submit Blocker with preventDefault() and Live Errors -->

<section>
<h2>Q9. Form Submit Blocker with Live Errors</h2>

<form id="validationForm" novalidate>

    <input id="userName" placeholder="Enter Name">
    <small id="nameError" class="error"></small>

    <input id="userEmail" placeholder="Enter Email">
    <small id="userEmailError" class="error"></small>

    <input id="userPassword" type="password" placeholder="Enter Password">
    <small id="userPasswordError" class="error"></small>

    <button type="submit">Submit</button>
</form>

<p id="successMessage"></p>
</section>

<script>
const form = document.getElementById("validationForm");

const nameInput = document.getElementById("userName");
const emailInput = document.getElementById("userEmail");
const passwordInput = document.getElementById("userPassword");

// Validate all fields
function validateForm() {

    document.getElementById("nameError").textContent =
        nameInput.value.trim() ? "" : "Name is required";

    document.getElementById("userEmailError").textContent =
        emailInput.value.includes("@") ? "" : "Email must contain @";

    document.getElementById("userPasswordError").textContent =
        passwordInput.value.length >= 6 ? "" : "Password must be at least 6 characters";

    return nameInput.value.trim() !== "" &&
           emailInput.value.includes("@") &&
           passwordInput.value.length >= 6;
}

// Remove errors automatically when correcting input
[nameInput, emailInput, passwordInput].forEach(input => {
    input.addEventListener("input", () => {
        validateForm();
        document.getElementById("successMessage").textContent = "";
    });
});

// Handle form submission
form.addEventListener("submit", (event) => {

    // Prevent default submission
    event.preventDefault();

    if (validateForm()) {
        document.getElementById("successMessage").textContent =
            "Form Submitted Successfully";

        form.reset();
    }
});
</script>

