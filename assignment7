<!-- Q1. Dynamic Product List Manager (Add, Edit, Delete - Using Event Delegation) -->

<section>
<h2>Q1. Dynamic Product List Manager</h2>
<input id="productInput" placeholder="Enter product name">
<button id="addProduct">Add Product</button>
<ul id="productList"></ul>
</section>

<script>
const input = document.getElementById("productInput");
const addButton = document.getElementById("addProduct");
const productList = document.getElementById("productList");

let editingItem = null;

// Add new product
addButton.addEventListener("click", () => {
    const name = input.value.trim();
    if (!name) return;

    const li = document.createElement("li");
    const span = document.createElement("span");
    span.className = "product-name";
    span.textContent = name;

    li.appendChild(span);
    li.innerHTML += ' <button data-action="edit">Edit</button> <button data-action="delete">Delete</button>';

    productList.appendChild(li);
    input.value = "";
});

// Save edited product
function saveEdit() {
    if (!editingItem) return;

    const editInput = editingItem.querySelector("input");
    const name = editInput.value.trim();

    if (name) {
        const span = document.createElement("span");
        span.className = "product-name";
        span.textContent = name;
        editInput.replaceWith(span);
    } else {
        editingItem.remove();
    }

    editingItem = null;
}

// Event delegation for Edit and Delete
productList.addEventListener("click", (event) => {
    const action = event.target.dataset.action;
    const li = event.target.closest("li");

    if (!li || !action) return;

    if (action === "delete") {
        if (editingItem === li) editingItem = null;
        li.remove();
    }

    if (action === "edit") {
        if (editingItem) saveEdit();

        const span = li.querySelector(".product-name");
        const editInput = document.createElement("input");
        editInput.value = span.textContent;
        span.replaceWith(editInput);

        editingItem = li;
        editInput.focus();

        editInput.addEventListener("keydown", (e) => {
            if (e.key === "Enter") saveEdit();
        });
    }
});

// Auto-save when clicking outside
document.addEventListener("click", (event) => {
    if (editingItem && !editingItem.contains(event.target)) {
        saveEdit();
    }
});
</script>


<!-- Q2. Live Character Counter with Warning Behavior -->

<section>
<h2>Q2. Live Character Counter</h2>
<textarea id="message" maxlength="100" placeholder="Write something"></textarea>
<p>Remaining: <span id="remaining">100</span></p>
<button id="resetCounter">Reset</button>
</section>

<script>
const textarea = document.getElementById("message");
const counter = document.getElementById("remaining");
const resetButton = document.getElementById("resetCounter");

// Prevent typing after 100 characters
textarea.addEventListener("keydown", (event) => {
    const allowed = ["Backspace", "Delete", "ArrowLeft", "ArrowRight", "Tab"];
    const selected = textarea.selectionStart !== textarea.selectionEnd;

    if (textarea.value.length >= 100 &&
        !allowed.includes(event.key) &&
        !event.ctrlKey && !event.metaKey && !selected) {
        event.preventDefault();
    }
});

// Update character counter
textarea.addEventListener("input", () => {
    const remaining = 100 - textarea.value.length;
    counter.textContent = remaining;

    if (remaining === 0) {
        counter.style.color = "red";
    } else if (remaining <= 20) {
        counter.style.color = "orange";
    } else {
        counter.style.color = "green";
    }
});

// Reset everything
resetButton.addEventListener("click", () => {
    textarea.value = "";
    counter.textContent = 100;
    counter.style.color = "green";
});
</script>


<!-- Q3. Multi-Step Form with Next/Back and Validation -->

<section>
<h2>Q3. Multi-Step Form</h2>

<div id="step1">
    <input id="stepName" placeholder="Enter Name">
    <button id="next1">Next</button>
</div>

<div id="step2" class="hidden">
    <input id="stepEmail" placeholder="Enter Email">
    <p id="emailError" class="error"></p>
    <button id="back2">Back</button>
    <button id="next2">Next</button>
</div>

<div id="step3" class="hidden">
    <input id="stepPassword" type="password" placeholder="Enter Password">
    <p id="passwordError" class="error"></p>
    <button id="back3">Back</button>
    <button id="finishForm">Finish</button>
</div>

<p id="formSummary"></p>
</section>

<script>
const steps = [
    document.getElementById("step1"),
    document.getElementById("step2"),
    document.getElementById("step3")
];

// Show selected step
function showStep(index) {
    steps.forEach((step, i) => {
        step.classList.toggle("hidden", i !== index);
    });
}

// Step 1 validation
document.getElementById("next1").addEventListener("click", () => {
    if (document.getElementById("stepName").value.trim()) {
        showStep(1);
    } else {
        alert("Please enter your name");
    }
});

// Step 2 email validation
document.getElementById("next2").addEventListener("click", () => {
    const email = document.getElementById("stepEmail").value;

    if (/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
        document.getElementById("emailError").textContent = "";
        showStep(2);
    } else {
        document.getElementById("emailError").textContent = "Enter valid email";
    }
});

// Back buttons
document.getElementById("back2").addEventListener("click", () => showStep(0));
document.getElementById("back3").addEventListener("click", () => showStep(1));

// Final submission
document.getElementById("finishForm").addEventListener("click", () => {
    const password = document.getElementById("stepPassword").value;

    if (password.length >= 6) {
        steps.forEach(step => step.classList.add("hidden"));

        document.getElementById("formSummary").textContent =
            "Name: " + document.getElementById("stepName").value +
            " | Email: " + document.getElementById("stepEmail").value +
            " | Form Completed Successfully";
    } else {
        document.getElementById("passwordError").textContent =
            "Password must be at least 6 characters";
    }
});
</script>


<!-- Q4. Theme Switcher Using Attribute Manipulation -->

<section>
<h2>Q4. Theme Switcher</h2>
<button data-theme="light">Light</button>
<button data-theme="dark">Dark</button>
<button data-theme="blue">Blue</button>
</section>

<script>
// Change theme using setAttribute()
document.querySelectorAll("[data-theme]").forEach(button => {
    button.addEventListener("click", () => {
        const theme = button.getAttribute("data-theme");

        document.body.setAttribute("class", theme);
        document.body.setAttribute("data-theme", theme);
    });
});

// Default theme
document.body.setAttribute("class", "light");
document.body.setAttribute("data-theme", "light");
</script>


