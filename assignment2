// Q1. Scope Conflict Resolver
// Declare a global variable bonus = 5000.
// Inside calculateSalary(), declare salary = 40000.
// Add bonus only if isPermanent is true.
// Print total salary and demonstrate local scope.

let bonus = 5000;

function calculateSalary(isPermanent) {
    let salary = 40000;

    if (isPermanent === true) {
        let totalSalary = salary + bonus;
        console.log("Total Salary:", totalSalary);
    } else {
        console.log("Total Salary:", salary);
    }

    console.log("Global Bonus:", bonus);
}

calculateSalary(true);
calculateSalary(false);

// Changing the global bonus affects future calculations.
bonus = 7000;
calculateSalary(true);


// Q2. String Manipulation Report
// Store a product name with extra spaces.
// Trim spaces, convert to lowercase and capitalize
// the first letter of each word.
// Replace "pro" with "Pro Edition".
// Display cleaned title and its length.

let productName = " wireless headphones PRO ";

let cleanedTitle = productName.trim().toLowerCase();

cleanedTitle = cleanedTitle
    .split(" ")
    .map(word => word.charAt(0).toUpperCase() + word.slice(1))
    .join(" ");

cleanedTitle = cleanedTitle.replace("Pro", "Pro Edition");

console.log("Cleaned Product Name:", cleanedTitle);
console.log("Title Length:", cleanedTitle.length);


