// Q6. Event-Based Counter Simulation
// Create count = 0.
// Create increment() and decrement() functions.
// Modify count and log current value.
// Simulate click events by calling functions.
// Use a nested function to demonstrate scope.

let count = 0;

function increment() {
    count++;
    console.log("Incremented Count:", count);
}

function decrement() {
    count--;
    console.log("Decremented Count:", count);
}

function counterManager() {
    function showCount() {
        console.log("Current Count:", count);
    }

    increment();
    increment();
    decrement();

    showCount();
}

counterManager();


