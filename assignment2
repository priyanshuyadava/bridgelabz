// Q8. Dynamic Discount Evaluator
// Create an array of cart objects.
// Electronics get 10% discount.
// Fashion gets 5% discount.
// If discounted cart total is greater than 50000,
// apply an extra 5% overall discount.
// Use loops, conditions and reduce().

const cart = [
    { item: "Laptop", category: "electronics", price: 45000 },
    { item: "Shoes", category: "fashion", price: 2500 },
    { item: "Book", category: "education", price: 600 }
];

let discountedCart = [];

for (let product of cart) {
    let price = product.price;

    if (product.category === "electronics") {
        price = price - (price * 0.10);
    } else if (product.category === "fashion") {
        price = price - (price * 0.05);
    }

    discountedCart.push({
        item: product.item,
        price: price
    });
}

let total = discountedCart.reduce((sum, product) => {
    return sum + product.price;
}, 0);

if (total > 50000) {
    total = total - (total * 0.05);
}

console.log("Discounted Cart:", discountedCart);
console.log("Final Cart Total:", total);


// Q9. Odd-Even Number Analyzer
// Create an array containing numbers 1 to 30 using a loop.
// If divisible by 3 and 5, print FizzBuzz.
// Else if even, print Even.
// Otherwise, print Odd.
// Store results in a new array using push().

const numbers = [];
const results = [];

for (let i = 1; i <= 30; i++) {
    numbers.push(i);

    if (i % 3 === 0 && i % 5 === 0) {
        results.push("FizzBuzz");
    } else if (i % 2 === 0) {
        results.push("Even");
    } else {
        results.push("Odd");
    }
}

console.log("Numbers:", numbers);
console.log("Results:", results);


// Q10. Departmental Employee Evaluator
// Create a nested array containing department names
// and performance scores.
// Excellent: score >= 90
// Good: score between 75 and 89
// Average: score between 60 and 74
// Needs Improvement: score below 60.
// Use loops and nested if-else conditions.

const departments = [
    ["HR", 72],
    ["Finance", 88],
    ["Tech", 95],
    ["Support", 63]
];

console.log("DEPARTMENT PERFORMANCE REPORT");

for (let department of departments) {
    const name = department[0];
    const score = department[1];

    let performance;

    if (score >= 90) {
        performance = "Excellent";
    } else if (score >= 75) {
        performance = "Good";
    } else if (score >= 60) {
        performance = "Average";
    } else {
        performance = "Needs Improvement";
    }

    console.log(
        `Department: ${name}, Score: ${score}, Performance: ${performance}`
    );
}


