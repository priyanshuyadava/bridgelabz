// Q4. Array Performance Analyzer
// Create an array of 8 random scores between 30 and 100.
// Calculate highest, lowest, average and passed students.
// Use map(), filter() and reduce().

const scores = Array.from(
    { length: 8 },
    () => Math.floor(Math.random() * 71) + 30
);

const highestScore = Math.max(...scores);
const lowestScore = Math.min(...scores);

const totalScore = scores.reduce((sum, score) => sum + score, 0);

const averageScore = totalScore / scores.length;

const passedStudents = scores.filter(score => score >= 50);

const updatedScores = scores.map(score => score);

console.log(`
ARRAY PERFORMANCE ANALYZER
---------------------------
Scores: ${updatedScores}
Highest Score: ${highestScore}
Lowest Score: ${lowestScore}
Average Score: ${averageScore.toFixed(2)}
Passed Students: ${passedStudents.length}
`);


